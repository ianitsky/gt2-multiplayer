<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>GT2Port</AssemblyName>
        <RootNamespace>GT2Port</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="generated/**/*.cs" Exclude="generated/Entry.cs" />
        <Compile Include="patches/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- LanSession's ClientIntent/Serialise/TryDeserialise are internal per
             the interface they were specified against, and the brief asks the
             test suite to round-trip them directly - same contract as
             RoomState's public pair - so the test assembly needs this grant. -->
        <InternalsVisibleTo Include="GT2Port.Tests" />
    </ItemGroup>

</Project>
