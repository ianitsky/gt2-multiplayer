<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>GT2Port</AssemblyName>
        <RootNamespace>GT2Port</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="generated/**/*.cs" Exclude="generated/Entry.cs" />
        <Compile Include="patches/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

</Project>
